{
  "name": "ripgrep",
  "repo": "BurntSushi/ripgrep",
  "tag_prefix": "",
  "format": "tarball",
  "output_binaries": ["rg"],
  "checksum": {
    "algorithm": "sha256"
  },
  "architectures": {
    "x86_64": {
      "asset_pattern": "ripgrep-{version}-x86_64-unknown-linux-musl.tar.gz",
      "extract_path": "ripgrep-*/rg",
      "checksum_asset": "ripgrep-{version}-x86_64-unknown-linux-musl.tar.gz.sha256"
    },
    "arm64": {
      "asset_pattern": "ripgrep-{version}-aarch64-unknown-linux-gnu.tar.gz",
      "extract_path": "ripgrep-*/rg",
      "checksum_asset": "ripgrep-{version}-aarch64-unknown-linux-gnu.tar.gz.sha256"
    }
  }
}
